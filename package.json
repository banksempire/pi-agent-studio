{
  "name": "pi-agent-studio",
  "version": "0.1.0",
  "description": "Web UI for the pi agent, built on the StudioFramework UI framework",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "node bin/studio.mjs",
    "dev": "vite --host 0.0.0.0 --port 7492",
    "server": "node --heapsnapshot-near-heap-limit=2 src/pi-studio/server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:crosswin": "node scripts/check-cross-window.cjs",
    "check:drafts": "node scripts/check-drafts.cjs",
    "check:mobile": "node scripts/check-mobile-open.cjs",
    "check:send-stop": "node scripts/check-send-stop.cjs",
    "check:queue": "node scripts/check-queue-msg.cjs",
    "check:dockericons": "node scripts/check-docker-icons.cjs",
    "check:jobeditor": "node scripts/check-job-editor.cjs",
    "check:sse": "node scripts/check-sse-flood.cjs",
    "check:states": "node scripts/check-session-states.cjs",
    "check:sync": "node scripts/check-session-sync.cjs",
    "check:pinned": "node scripts/check-pinned.cjs",
    "check:restart": "node scripts/check-gateway-restart.cjs",
    "check:cli": "node scripts/check-cli.cjs",
    "check:registry": "node scripts/check-registry-drain.cjs",
    "check:stream-scroll": "node scripts/check-stream-scroll.cjs",
    "check:backend-restart": "node scripts/check-backend-restart.cjs",
    "check:restart-selfkill": "node scripts/check-restart-selfkill.cjs",
    "check:modelapi": "node scripts/check-model-api.cjs",
    "check:peakhours": "node scripts/check-peak-hours.cjs",
    "check:scheduler": "node scripts/check-scheduler.cjs"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.9"
  }
}
