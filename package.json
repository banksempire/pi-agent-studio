{
  "name": "pi-agent-studio",
  "version": "0.1.0",
  "description": "Web UI for the pi agent, built on the StudioFramework UI framework",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7492",
    "server": "node src/pi-studio/server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "nest": "node src/pi-nest/src/index.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:crosswin": "node scripts/check-cross-window.cjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.13",
    "dompurify": "^3.4.13",
    "marked": "^18.0.9",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.9"
  }
}
