{
  "$comment": "pi-agent-studio layout. Built on the StudioFramework single-JSON layout model.",
  "framework": {
    "title": "pi-agent-studio"
  },
  "menu": [
    {
      "id": "chat",
      "label": "Chat",
      "items": [
        {
          "id": "new-chat",
          "label": "New Chat",
          "icon": "💬",
          "accelerator": "Ctrl+N",
          "action": "new-chat"
        },
        {
          "separator": true
        },
        {
          "id": "model-catalog",
          "label": "Model Catalog…",
          "action": "open-model-catalog"
        },
        {
          "id": "peak-hours",
          "label": "Peak Hours…",
          "action": "open-peak-hours"
        },
        {
          "id": "open-jobs",
          "label": "Scheduled Jobs…",
          "action": "open-jobs"
        },
        {
          "separator": true
        },
        {
          "id": "refresh-model-catalog",
          "label": "Refresh Catalog",
          "accelerator": "Ctrl+Alt+R",
          "action": "refresh-model-catalog"
        }
      ]
    },
    {
      "id": "view",
      "label": "View",
      "items": [
        {
          "id": "view-chat-panel",
          "label": "Toggle Chat Panel",
          "action": "toggle-left-panel"
        },
        {
          "id": "view-stats-panel",
          "label": "Toggle Session Stats",
          "action": "toggle-right-panel"
        }
      ]
    },
    {
      "id": "help",
      "label": "Help",
      "items": [
        {
          "id": "about",
          "label": "About pi-agent-studio",
          "action": "about"
        }
      ]
    }
  ],
  "docker": [
    {
      "id": "chat",
      "displayName": "Chat",
      "icon": "💬",
      "panel": {
        "title": "Chat",
        "sections": [
          {
            "id": "chat",
            "label": "Chat",
            "subSections": [
              {
                "id": "pinned",
                "label": "Pinned",
                "height": "fixed",
                "minHeight": 60,
                "components": [
                  {
                    "type": "component",
                    "key": "chat-history",
                    "props": { "pinned": true }
                  }
                ]
              },
              {
                "id": "history",
                "label": "Chat History",
                "height": "variable",
                "minHeight": 90,
                "utilities": [
                  {
                    "id": "new-chat",
                    "icon": "➕",
                    "label": "New Chat",
                    "tooltip": "New Chat (Ctrl+N)",
                    "closeMobilePanel": true
                  }
                ],
                "components": [
                  {
                    "type": "component",
                    "key": "chat-history"
                  }
                ]
              },
              {
                "id": "sessions",
                "label": "Sessions",
                "height": "variable",
                "minHeight": 80,
                "utilities": [
                  {
                    "id": "session-filter",
                    "icon": "filter",
                    "tooltip": "Filter sessions by status"
                  }
                ],
                "components": [
                  {
                    "type": "component",
                    "key": "chat-sessions"
                  }
                ]
              }
            ]
          },
          {
            "id": "directory",
            "label": "Directory",
            "subSections": [
              {
                "id": "directory",
                "label": "Directory",
                "height": "variable",
                "minHeight": 80,
                "components": [
                  {
                    "type": "component",
                    "key": "directory-tree"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "workspace",
      "displayName": "Workspace",
      "icon": "🗂",
      "panel": {
        "title": "Workspaces",
        "sections": [
          {
            "id": "workspaces",
            "label": "Workspaces",
            "subSections": [
              {
                "id": "ws-panel",
                "label": "Saved Workspaces",
                "height": "variable",
                "minHeight": 120,
                "components": [
                  {
                    "type": "component",
                    "key": "workspace-panel"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "rightPanels": {
    "jobs": {
      "title": "SCHEDULER",
      "sections": [
        {
          "id": "detail",
          "label": "Detail",
          "subSections": [
            {
              "id": "job-detail",
              "label": "Job Detail",
              "height": "fixed",
              "minHeight": 80,
              "utilities": [
                {
                  "id": "edit-job",
                  "icon": "✎",
                  "label": "Edit",
                  "tooltip": "Edit job"
                }
              ],
              "components": [
                {
                  "type": "component",
                  "key": "job-detail"
                }
              ]
            },
            {
              "id": "job-history",
              "label": "History",
              "height": "variable",
              "minHeight": 60,
              "components": [
                {
                  "type": "component",
                  "key": "job-history"
                }
              ]
            }
          ]
        },
        {
          "id": "preference",
          "label": "Preference",
          "subSections": [
            {
              "id": "scheduler-prefs",
              "label": "Concurrent Job",
              "height": "fixed",
              "components": [
                {
                  "type": "component",
                  "key": "scheduler-prefs"
                }
              ]
            }
          ]
        }
      ]
    },
    "peak-hours": {
      "title": "Model Detail",
      "sections": [
        {
          "id": "model-detail",
          "label": "Model Detail",
          "subSections": [
            {
              "id": "model-detail",
              "label": "Model Detail",
              "height": "fixed",
              "components": [
                {
                  "type": "component",
                  "key": "model-detail"
                }
              ]
            }
          ]
        }
      ]
    },
    "model-catalog": {
      "title": "Model Catalog",
      "sections": [
        {
          "id": "model-catalog",
          "label": "Model Catalog",
          "subSections": [
            {
              "id": "model-detail",
              "label": "Model Detail",
              "height": "fixed",
              "components": [
                {
                  "type": "component",
                  "key": "model-detail"
                }
              ]
            },
            {
              "id": "model-preference",
              "label": "Preference",
              "height": "fixed",
              "components": [
                {
                  "type": "component",
                  "key": "model-preference"
                }
              ]
            },
            {
              "id": "peak-hours",
              "label": "Peak Hours",
              "height": "variable",
              "minHeight": 80,
              "components": [
                {
                  "type": "component",
                  "key": "peak-hours"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "right": {
    "title": "Chat",
    "sections": [
      {
        "id": "session",
        "label": "Session",
        "subSections": [
          {
            "id": "session-model",
            "label": "Model",
            "height": "fixed",
            "components": [
              {
                "type": "component",
                "key": "model-picker"
              }
            ]
          },
          {
            "id": "session-stats",
            "label": "Stats",
            "height": "fixed",
            "components": [
              {
                "type": "component",
                "key": "session-stats"
              }
            ]
          }
        ]
      },
      {
        "id": "preference",
        "label": "Preference",
        "subSections": [
          {
            "id": "prefs",
            "label": "Preference",
            "height": "fixed",
            "components": [
              {
                "type": "component",
                "key": "prefs"
              }
            ]
          }
        ]
      }
    ]
  },
  "workspace": {
    "minTileWidth": 220,
    "minTileHeight": 140,
    "emptyContent": "welcome",
    "tabs": []
  },
  "status": {
    "left": [
      {
        "id": "backend",
        "component": "backend-status"
      }
    ],
    "right": [
      {
        "id": "cwd",
        "label": "/workspace/sf"
      }
    ]
  }
}
