{
  "$comment": "pi-agent-studio layout. Built on the StudioFramework single-JSON layout model.",
  "framework": {
    "title": "pi-agent-studio"
  },
  "menu": [
    {
      "id": "chat",
      "label": "Chat",
      "items": [
        {
          "id": "new-chat",
          "label": "New Chat",
          "icon": "💬",
          "accelerator": "Ctrl+N",
          "action": "new-chat"
        },
        {
          "separator": true
        },
        {
          "id": "model-catalog",
          "label": "Model Catalog…",
          "action": "open-model-catalog"
        },
        {
          "id": "peak-hours",
          "label": "Peak Hours…",
          "action": "open-peak-hours"
        },
        {
          "id": "open-jobs",
          "label": "Scheduled Jobs…",
          "action": "open-jobs"
        },
        {
          "separator": true
        },
        {
          "id": "refresh-model-catalog",
          "label": "Refresh Catalog",
          "accelerator": "Ctrl+Alt+R",
          "action": "refresh-model-catalog"
        }
      ]
    },
    {
      "id": "view",
      "label": "View",
      "items": [
        {
          "id": "view-chat-panel",
          "label": "Toggle Chat Panel",
          "action": "toggle-left-panel"
        },
        {
          "id": "view-stats-panel",
          "label": "Toggle Session Stats",
          "action": "toggle-right-panel"
        }
      ]
    },
    {
      "id": "help",
      "label": "Help",
      "items": [
        {
          "id": "about",
          "label": "About pi-agent-studio",
          "action": "about"
        }
      ]
    }
  ],
  "docker": [
    {
      "id": "chat",
      "displayName": "Chat",
      "icon": "💬",
      "panel": {
        "title": "Chat",
        "sections": [
          {
            "id": "chat",
            "label": "Chat",
            "subSections": [
              {
                "id": "pinned",
                "label": "Pinned",
                "height": "fixed",
                "minHeight": 60,
                "components": [
                  {
                    "type": "list",
                    "bind": "chat-pinned",
                    "dismissOnActivate": true
                  }
                ]
              },
              {
                "id": "history",
                "label": "Chat History",
                "height": "variable",
                "minHeight": 90,
                "utilities": [
                  {
                    "id": "new-chat",
                    "icon": "➕",
                    "label": "New Chat",
                    "tooltip": "New Chat (Ctrl+N)",
                    "closeMobilePanel": true
                  }
                ],
                "components": [
                  {
                    "type": "list",
                    "bind": "chat-history",
                    "dismissOnActivate": true
                  }
                ]
              },
              {
                "id": "sessions",
                "label": "Sessions",
                "height": "variable",
                "minHeight": 80,
                "utilities": [
                  {
                    "id": "session-filter",
                    "icon": "filter",
                    "tooltip": "Filter sessions by status"
                  }
                ],
                "components": [
                  {
                    "type": "list",
                    "bind": "chat-sessions",
                    "dismissOnActivate": true
                  }
                ]
              }
            ]
          },
          {
            "id": "directory",
            "label": "Directory",
            "subSections": [
              {
                "id": "directory",
                "label": "Directory",
                "height": "variable",
                "minHeight": 80,
                "components": [
                  {
                    "type": "tree",
                    "bind": "directory-tree",
                    "stateKey": "directory-tree",
                    "empty": "Loading directories…"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "workspace",
      "displayName": "Workspace",
      "icon": "🗂",
      "panel": {
        "title": "Workspaces",
        "sections": [
          {
            "id": "workspaces",
            "label": "Workspaces",
            "subSections": [
              {
                "id": "ws-panel",
                "label": "Saved Workspaces",
                "height": "variable",
                "minHeight": 120,
                "components": [
                  {
                    "type": "component",
                    "key": "workspace-panel"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ],
  "rightPanels": {
    "jobs": {
      "title": "SCHEDULER",
      "sections": [
        {
          "id": "detail",
          "label": "Detail",
          "subSections": [
            {
              "id": "job-detail",
              "label": "Job Detail",
              "height": "fixed",
              "minHeight": 80,
              "utilities": [
                {
                  "id": "edit-job",
                  "icon": "✎",
                  "label": "Edit",
                  "tooltip": "Edit job"
                }
              ],
              "components": [
                {
                  "type": "keyValueList",
                  "bind": "job-detail-rows",
                  "maxHeight": 320
                }
              ]
            },
            {
              "id": "job-history",
              "label": "History",
              "height": "variable",
              "minHeight": 60,
              "components": [
                {
                  "type": "table",
                  "bind": "job-runs",
                  "resizable": false,
                  "empty": "no runs yet",
                  "columns": [
                    {
                      "key": "status",
                      "label": "Status",
                      "min": 48,
                      "kind": "status",
                      "mobile": "lead"
                    },
                    {
                      "key": "time",
                      "label": "Queued",
                      "min": 56,
                      "kind": "time",
                      "mobile": "sub"
                    },
                    {
                      "key": "session",
                      "label": "Session",
                      "min": 60,
                      "kind": "mono",
                      "mobile": "title"
                    },
                    {
                      "key": "error",
                      "label": "Error",
                      "min": 60,
                      "kind": "danger"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "preference",
          "label": "Preference",
          "subSections": [
            {
              "id": "scheduler-prefs",
              "label": "Concurrent Job",
              "height": "fixed",
              "components": [
                {
                  "type": "form",
                  "bind": "scheduler-caps"
                }
              ]
            }
          ]
        }
      ]
    },
    "peak-hours": {
      "title": "Model Detail",
      "sections": [
        {
          "id": "model-detail",
          "label": "Model Detail",
          "subSections": [
            {
              "id": "model-detail",
              "label": "Model Detail",
              "height": "fixed",
              "components": [
                {
                  "type": "keyValueList",
                  "bind": "model-detail-rows",
                  "empty": "Click a model in the Model Catalog to inspect it."
                }
              ]
            }
          ]
        }
      ]
    },
    "model-catalog": {
      "title": "Model Catalog",
      "sections": [
        {
          "id": "model-catalog",
          "label": "Model Catalog",
          "subSections": [
            {
              "id": "model-detail",
              "label": "Model Detail",
              "height": "fixed",
              "components": [
                {
                  "type": "keyValueList",
                  "bind": "model-detail-rows",
                  "empty": "Click a model in the Model Catalog to inspect it."
                }
              ]
            },
            {
              "id": "model-preference",
              "label": "Preference",
              "height": "fixed",
              "components": [
                {
                  "type": "form",
                  "bind": "model-preference-rows"
                }
              ]
            },
            {
              "id": "peak-hours",
              "label": "Peak Hours",
              "height": "variable",
              "minHeight": 80,
              "components": [
                {
                  "type": "header",
                  "bind": "peak-model",
                  "variant": "plain",
                  "action": {
                    "label": "add",
                    "icon": "＋",
                    "variant": "accent",
                    "title": "Add peak hours",
                    "action": "peak-add"
                  }
                },
                {
                  "type": "banner",
                  "bind": "peak-error",
                  "tone": "error"
                },
                {
                  "type": "list",
                  "bind": "peak-hours-rows",
                  "variant": "card"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "right": {
    "title": "Chat",
    "sections": [
      {
        "id": "session",
        "label": "Session",
        "subSections": [
          {
            "id": "session-model",
            "label": "Model",
            "height": "fixed",
            "components": [
              {
                "type": "keyValueList",
                "bind": "model-picker-rows"
              },
              {
                "type": "menuButton",
                "label": "Change Model",
                "bind": "model-picker-menu",
                "title": "Change Model",
                "action": "pick-model"
              },
              {
                "type": "banner",
                "bind": "model-picker-note",
                "tone": "info"
              }
            ]
          },
          {
            "id": "session-stats",
            "label": "Stats",
            "height": "fixed",
            "components": [
              {
                "type": "header",
                "bind": "session-header",
                "variant": "bar"
              },
              {
                "type": "keyValueList",
                "bind": "session-stats"
              }
            ]
          }
        ]
      },
      {
        "id": "preference",
        "label": "Preference",
        "subSections": [
          {
            "id": "prefs",
            "label": "Preference",
            "height": "fixed",
            "components": [
              {
                "type": "form",
                "bind": "prefs-rows"
              }
            ]
          }
        ]
      }
    ]
  },
  "workspace": {
    "minTileWidth": 220,
    "minTileHeight": 140,
    "emptyContent": "welcome",
    "tabs": []
  },
  "status": {
    "left": [
      {
        "id": "backend",
        "component": "backend-status"
      }
    ],
    "right": [
      {
        "id": "cwd",
        "label": "",
        "bind": "app-cwd"
      }
    ]
  }
}
